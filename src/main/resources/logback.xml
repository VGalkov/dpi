<configuration scan="true" scanPeriod="10 seconds">

    <!-- Файл с ротацией -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <immediateFlush>true</immediateFlush>
    </appender>

    <!-- Консоль -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <immediateFlush>true</immediateFlush>
    </appender>

    <!-- Файловый асинхронный аппендер -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock>
    </appender>

    <!-- Консольный асинхронный аппендер -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock>
    </appender>

    <!-- ==================   УРОВНИ ЛОГИРОВАНИЯ   ===================================== -->

    <!-- Hot path: только WARN и выше -->
    <logger name="ru.galkov.servers.ProxyHandler" level="WARN">
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <logger name="ru.galkov.servers.HttpProxyServer" level="WARN">
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <logger name="ru.galkov.servers.DnsServer" level="WARN">
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <logger name="ru.galkov.util.ProxyHandlerHelper" level="WARN">
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <!-- Бизнес-логика: INFO -->
    <logger name="ru.galkov.AppConfig" level="INFO">
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <!-- ===================================  ROOT (по умолчанию) ==================================== -->

    <root level="DEBUG">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>

</configuration>